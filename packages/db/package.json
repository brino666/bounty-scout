{
  "name": "@bounty-scout/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "push": "dotenv -e ../../apps/api/.env -- drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "dotenv -e ../../apps/api/.env -- drizzle-kit push --force --config ./drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.31.10"
  }
}
