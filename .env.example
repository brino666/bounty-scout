# ============================================================
# HackerOne Scout — environment configuration
# Copy this to .env in apps/api (and set the same values as
# Environment Variables in your Vercel project once you deploy).
# ============================================================

# --- Database (Supabase) --------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string
# (use the "URI" one, "Transaction" mode is fine)
DATABASE_URL=

# --- LLM (required for scope analysis + report drafting) -----------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- HackerOne (required for the discovery scout + real scope data) -
# hackerone.com → your account → Settings → API Token
H1_API_USERNAME=
H1_API_TOKEN=

# --- Server ----------------------------------------------------------
# Local dev only — Vercel sets this automatically when deployed.
PORT=8080
